<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Core.fs" />
    <Compile Include="Memory.fs" />
    <Compile Include="Rag.fs" />
    <Compile Include="Retrieval.fs" />
    <Compile Include="Provenance.fs" />
    <Compile Include="Runs.fs" />
    <Compile Include="ResearchModel.fs" />
    <Compile Include="ResearchCanonical.fs" />
    <Compile Include="ResearchArchitecture.fs" />
    <Compile Include="ResearchLedger.fs" />
    <Compile Include="ResearchGitImport.fs" />
    <Compile Include="ResearchMetrics.fs" />
    <Compile Include="ResearchExport.fs" />
    <Compile Include="ResearchRuntime.fs" />
    <Compile Include="ResearchActivation.fs" />
    <Compile Include="ResearchCollector.fs" />
    <Compile Include="ResearchCli.fs" />
    <Compile Include="Retention.fs" />
    <Compile Include="Assets.fs" />
    <Compile Include="BlenderCalibration.fs" />
    <Compile Include="Asset3dInspector.fs" Condition="Exists('Asset3dInspector.fs')" />
    <Compile Include="AssetJobJournal.fs" Condition="Exists('AssetJobJournal.fs')" />
    <Compile Include="DotnetAssetGenerator.fs" Condition="Exists('DotnetAssetGenerator.fs')" />
    <Compile Include="DotnetAssetCiEvidence.fs" Condition="Exists('DotnetAssetCiEvidence.fs')" />
    <Compile Include="DotnetAssetPipeline.fs" Condition="Exists('DotnetAssetPipeline.fs')" />
    <Compile Include="ToolchainCheck.fs" />
    <Compile Include="Verification.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="[8.0.5]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AssetJobJournal.fs" LogicalName="RiftHarness.GeneratorSource.AssetJobJournal.fs" />
    <EmbeddedResource Include="BlenderCalibration.fs" LogicalName="RiftHarness.GeneratorSource.BlenderCalibration.fs" />
    <EmbeddedResource Include="DotnetAssetGenerator.fs" LogicalName="RiftHarness.GeneratorSource.DotnetAssetGenerator.fs" />
    <AssemblyMetadata Include="RiftwardDotnetSdkVersion" Value="$(NETCoreSdkVersion)" />
  </ItemGroup>
</Project>
