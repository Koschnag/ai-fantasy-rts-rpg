* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
# Accepted binary source assets live in Git LFS; quarantine/cooked output is ignored
*.blend filter=lfs diff=lfs merge=lfs -text
