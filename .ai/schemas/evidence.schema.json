{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-riftward.invalid/schemas/evidence.schema.json",
  "title": "Verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "runId", "taskId", "criterionIds", "kind", "command", "exitCode", "startedAtUtc", "durationMs", "artifacts", "environment", "resultSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceId": { "type": "string", "minLength": 8 },
    "runId": { "type": "string" },
    "taskId": { "type": "string" },
    "criterionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "kind": { "enum": ["build", "unit-test", "integration-test", "replay", "benchmark", "visual", "asset-validation", "security", "license", "manual-review"] },
    "command": { "type": ["string", "null"] },
    "exitCode": { "type": ["integer", "null"] },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "environment": { "type": "object" },
    "metrics": { "type": "object" },
    "resultSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
