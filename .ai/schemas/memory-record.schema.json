{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-riftward.invalid/schemas/memory-record.schema.json",
  "title": "Curated memory record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "statement", "status", "confidence", "scope", "sources", "createdAtUtc", "createdBy", "tags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^MEM-[0-9]{4,}$" },
    "kind": { "enum": ["fact", "constraint", "decision", "definition", "lesson", "preference"] },
    "statement": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "status": { "enum": ["proposed", "accepted", "stale", "superseded", "rejected"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "locator"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "locator": { "type": "string" },
          "runId": { "type": ["string", "null"] }
        }
      }
    },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "reviewedAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "reviewedBy": { "type": ["string", "null"] },
    "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^MEM-[0-9]{4,}$" } },
    "expiresAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
  }
}
