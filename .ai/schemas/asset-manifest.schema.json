{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-riftward.invalid/schemas/asset-manifest.schema.json",
  "title": "Generated asset provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "purpose", "specSha256", "generationRunId", "generationBindingMode", "generationReceipt", "generationReceiptSha256", "createdBy", "status", "generator", "inputs", "prompts", "outputs", "transformations", "licenseBasis", "reviews", "supersedes", "createdAtUtc"],
  "allOf": [
    {
      "if": {
        "properties": {
          "generator": {
            "properties": { "kind": { "const": "ai" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "generator": {
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "modelVersion": { "type": "string", "minLength": 1 }
            }
          },
          "prompts": { "$ref": "#/$defs/prompts" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generator": {
            "properties": { "kind": { "const": "ai" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "generator": {
            "properties": {
              "generatorSourceSha256": { "type": "null" },
              "toolchainPin": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generator": {
            "properties": {
              "kind": { "const": "ai" },
              "executionMode": { "const": "local" }
            },
            "required": ["kind", "executionMode"]
          }
        }
      },
      "then": {
        "properties": {
          "generator": {
            "properties": {
              "modelArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "required": ["modelArtifactSha256"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generator": {
            "properties": { "kind": { "const": "procedural" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "generator": {
            "properties": {
              "model": { "type": "null" },
              "modelVersion": { "type": "null" },
              "modelArtifactSha256": { "type": "null" },
              "generatorSourceSha256": { "$ref": "#/$defs/sha256" },
              "toolchainPin": { "type": "string", "minLength": 1 },
              "seed": { "type": ["string", "integer"] }
            }
          },
          "prompts": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "approved" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "licenseBasis": {
            "properties": {
              "commercialUseReviewed": { "const": true },
              "reviewedAtUtc": { "type": "string", "format": "date-time" }
            },
            "required": ["reviewedAtUtc"]
          },
          "generationBindingMode": { "const": "canonical-event-v1" },
          "reviews": {
            "allOf": [
              { "contains": { "properties": { "kind": { "const": "technical" }, "active": { "const": true }, "result": { "const": "pass" } }, "required": ["kind", "active", "result"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "kind": { "const": "visual" }, "active": { "const": true }, "result": { "const": "pass" } }, "required": ["kind", "active", "result"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "kind": { "const": "performance" }, "active": { "const": true }, "result": { "const": "pass" } }, "required": ["kind", "active", "result"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "kind": { "const": "originality" }, "active": { "const": true }, "result": { "const": "pass" } }, "required": ["kind", "active", "result"] }, "minContains": 1, "maxContains": 1 },
              { "contains": { "properties": { "kind": { "const": "license" }, "active": { "const": true }, "result": { "const": "pass" } }, "required": ["kind", "active", "result"] }, "minContains": 1, "maxContains": 1 }
            ],
            "not": {
              "contains": {
                "properties": {
                  "active": { "const": true },
                  "result": { "enum": ["fail", "needs-work"] }
                },
                "required": ["active", "result"]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "assetId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+(?:-[A-Z0-9]+)+$" },
    "purpose": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "specSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generationRunId": { "$ref": "#/$defs/runId" },
    "generationBindingMode": { "enum": ["canonical-event-v1", "legacy-event-v0"] },
    "generationReceipt": { "type": "string", "pattern": "^assets/receipts/[A-Z][A-Z0-9]+(?:-[A-Z0-9]+)+/[0-9A-HJKMNP-TV-Z]{26}\\.json$" },
    "generationReceiptSha256": { "$ref": "#/$defs/sha256" },
    "createdBy": { "$ref": "#/$defs/actorId" },
    "status": { "enum": ["quarantine", "technical-review", "visual-review", "approved", "rejected", "superseded"] },
    "generator": { "$ref": "#/$defs/generator" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "prompts": { "oneOf": [{ "$ref": "#/$defs/prompts" }, { "type": "null" }] },
    "outputs": { "$ref": "#/$defs/outputs" },
    "transformations": { "$ref": "#/$defs/transformations" },
    "licenseBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelTerms", "inputRights", "outputPolicy", "commercialUseReviewed", "termsEvidenceArtifact"],
      "properties": {
        "modelTerms": { "$ref": "#/$defs/nonBlankEvidence" },
        "inputRights": { "$ref": "#/$defs/nonBlankEvidence" },
        "outputPolicy": { "$ref": "#/$defs/nonBlankEvidence" },
        "commercialUseReviewed": { "type": "boolean" },
        "reviewedAtUtc": { "type": ["string", "null"], "format": "date-time" },
        "termsEvidenceArtifact": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "$ref": "#/$defs/path" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "properties": { "kind": { "const": "technical" }, "active": { "const": true } }, "required": ["kind", "active"] }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "visual" }, "active": { "const": true } }, "required": ["kind", "active"] }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "performance" }, "active": { "const": true } }, "required": ["kind", "active"] }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "originality" }, "active": { "const": true } }, "required": ["kind", "active"] }, "minContains": 0, "maxContains": 1 },
        { "contains": { "properties": { "kind": { "const": "license" }, "active": { "const": true } }, "required": ["kind", "active"] }, "minContains": 0, "maxContains": 1 }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewId", "revision", "active", "kind", "reviewerId", "atUtc", "result", "evidence", "evidenceArtifact", "supersedesReviewId"],
        "properties": {
          "reviewId": { "type": "string", "minLength": 1 },
          "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "active": { "type": "boolean" },
          "kind": { "enum": ["technical", "visual", "performance", "originality", "license"] },
          "reviewerId": { "$ref": "#/$defs/actorId" },
          "atUtc": { "type": "string", "format": "date-time" },
          "result": { "enum": ["pass", "fail", "needs-work"] },
          "evidence": { "type": "string" },
          "evidenceArtifact": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256", "runId", "reviewerId"],
                "properties": {
                  "path": { "$ref": "#/$defs/path" },
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "runId": { "$ref": "#/$defs/runId" },
                  "reviewerId": { "$ref": "#/$defs/actorId" }
                }
              }
            ]
          },
          "supersedesReviewId": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "supersedes": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/$defs/assetId" } },
    "createdAtUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tool", "version", "model", "modelVersion", "modelArtifactSha256", "executionMode", "seed", "generatorSourceSha256", "toolchainPin"],
      "properties": {
        "kind": { "enum": ["ai", "procedural", "manual"] },
        "tool": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "modelVersion": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "modelArtifactSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "executionMode": { "enum": ["local", "remote"] },
        "seed": { "type": ["string", "integer", "null"] },
        "generatorSourceSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "toolchainPin": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "origin", "originClass", "creativeInfluence", "license", "rightsEvidence", "allowedUse", "referenceUseReviewed"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "path": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "origin": { "$ref": "#/$defs/nonBlankEvidence" },
          "originClass": { "enum": ["internal-specification", "agentic-synthetic", "technical-nonexpressive"] },
          "creativeInfluence": { "type": "boolean" },
          "license": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "(?s)^(?=.*\\S).+$" },
          "rightsEvidence": { "$ref": "#/$defs/nonBlankEvidence" },
          "allowedUse": { "enum": ["generation-input", "technical-calibration", "internal-specification"] },
          "referenceUseReviewed": { "const": true }
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "negativePrompt", "promptSha256", "promptEnvelopeSha256", "bindingMode"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 64000 },
        "negativePrompt": { "type": ["string", "null"], "maxLength": 32000 },
        "promptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "promptEnvelopeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bindingMode": { "enum": ["canonical-envelope-v1", "legacy-prompt-only"] }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mediaType", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "technicalMetrics": { "type": "object" }
        }
      }
    },
    "transformations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "version", "operation", "parametersSha256"],
        "properties": {
          "tool": { "type": "string", "minLength": 1, "maxLength": 256 },
          "version": { "type": "string", "minLength": 1, "maxLength": 256 },
          "operation": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "parametersSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "assetId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+(?:-[A-Z0-9]+)+$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512 },
    "runId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "actorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$" },
    "nonBlankEvidence": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "(?s)^(?=.*\\S).+$" }
  }
}
