{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-riftward.invalid/schemas/task.schema.json",
  "title": "Machine-executable project task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "status", "objective", "inScope", "outOfScope", "requirements", "acceptanceCriteria", "requiredGates", "decisionPolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^T-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 5 },
    "status": { "enum": ["draft", "ready", "running", "review", "accepted", "blocked", "cancelled"] },
    "releaseNote": {
      "type": "string",
      "description": "Optionaler, datierter Vermerk zur Statusfreigabe (z. B. draft -> ready) mit Autorisierung und Blockerpruefung."
    },
    "reviewNote": {
      "type": "string",
      "description": "Optionaler, datierter Vermerk zu Implementierungs-, Review- und Akzeptanzstaenden mit Run-IDs; nie Ersatz fuer Evidenz."
    },
    "completionNote": {
      "type": "string",
      "description": "Optionaler, datierter Vermerk zum Implementierungsabschluss mit Run-IDs und Restpunkten; nie Ersatz fuer Evidenz."
    },
    "objective": { "type": "string", "minLength": 10 },
    "inScope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outOfScope": { "type": "array", "items": { "type": "string" } },
    "requirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "verification"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "verification": { "type": "string" }
        }
      }
    },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "requiredGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mayDecide", "mustEscalate"],
      "properties": {
        "mayDecide": { "type": "array", "items": { "type": "string" } },
        "mustEscalate": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
