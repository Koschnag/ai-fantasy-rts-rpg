{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-riftward.invalid/schemas/retrieval-record.schema.json",
  "title": "Recorded RAG query and citations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "queryId", "runId", "timestampUtc", "query", "indexSha256", "configSha256", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "queryId": { "type": "string" },
    "runId": { "type": "string" },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "query": { "type": "string", "minLength": 1 },
    "indexSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "configSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "score", "chunkId", "path", "startLine", "endLine", "contentSha256", "trustClass"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "score": { "type": "number" },
          "chunkId": { "type": "string" },
          "path": { "type": "string" },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "trustClass": { "enum": ["accepted-decision", "specification", "accepted-memory", "ready-task", "documentation", "code", "untrusted"] }
        }
      }
    }
  }
}
