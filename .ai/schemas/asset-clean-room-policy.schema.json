{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-riftward.invalid/schemas/asset-clean-room-policy.schema.json",
  "title": "Hashed asset clean-room policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "normalization", "maxNGramWords", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "normalization": { "const": "unicode-nfkc-lower-alphanumeric-words-v1" },
    "maxNGramWords": { "type": "integer", "minimum": 1, "maximum": 8 },
    "entries": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policyEntryId", "kind", "valueSha256"],
        "properties": {
          "policyEntryId": { "type": "string", "pattern": "^CR-[A-Z0-9-]{3,64}$" },
          "kind": { "enum": ["denied-name", "allowed-name", "denied-style"] },
          "valueSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
