{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-riftward.invalid/schemas/harness-config.schema.json",
  "title": "Rift Harness configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "policy", "paths", "rag", "logging", "security"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truthOrder", "unknownsMustRemainExplicit", "retrievedTextIsUntrustedData", "automaticMemoryPromotion"],
      "properties": {
        "truthOrder": { "const": ["accepted-decision", "project-and-requirements", "accepted-memory", "ready-task", "other-documentation", "code"] },
        "unknownsMustRemainExplicit": { "const": true },
        "retrievedTextIsUntrustedData": { "const": true },
        "automaticMemoryPromotion": { "const": false }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "index", "cache", "acceptedHistory", "memory", "tasks"],
      "properties": {
        "runs": { "const": ".ai/runtime/runs" },
        "index": { "const": ".ai/runtime/index" },
        "cache": { "const": ".ai/runtime/cache" },
        "acceptedHistory": { "const": ".ai/history/accepted" },
        "memory": { "type": "string", "minLength": 1 },
        "tasks": { "const": ".ai/tasks" }
      }
    },
    "rag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "extensions", "excludedSegments", "maxFileBytes", "chunkLines", "overlapLines", "ranking", "defaultTopK", "maxContextCharacters"],
      "properties": {
        "roots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "extensions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\." } },
        "excludedSegments": { "type": "array", "items": { "type": "string" } },
        "maxFileBytes": { "type": "integer", "minimum": 1024 },
        "chunkLines": { "type": "integer", "minimum": 8, "maximum": 500 },
        "overlapLines": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "k1", "b"],
          "properties": {
            "algorithm": { "const": "bm25" },
            "k1": { "type": "number", "exclusiveMinimum": 0 },
            "b": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "defaultTopK": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxContextCharacters": { "type": "integer", "minimum": 1000 }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "utcOnly", "hashChain", "rawRunRetentionDays", "acceptedSummariesRetentionDays", "maxEventPayloadBytes"],
      "properties": {
        "format": { "const": "jsonl" },
        "utcOnly": { "const": true },
        "hashChain": { "const": true },
        "rawRunRetentionDays": { "const": 180 },
        "acceptedSummariesRetentionDays": { "const": 0 },
        "maxEventPayloadBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redactKeyPatterns", "redactValuePatterns", "neverIndex"],
      "properties": {
        "redactKeyPatterns": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "redactValuePatterns": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "neverIndex": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
