{"schemaVersion":1,"id":"MEM-0007","kind":"constraint","statement":"Produktionsagenten arbeiten ausschließlich aus bereinigten internen Anforderungen und Bibles. Fremde Spielmedien, extrahierte Inhalte, namentliche Stilabkürzungen, Decompilation und Eins-zu-eins-Rekonstruktionen sind ausgeschlossen; zweifelhafte Ergebnisse bleiben in Quarantäne und benötigen unabhängiges Originalitäts- und Lizenzreview.","status":"accepted","confidence":1.0,"scope":"production/ip-clean-room","sources":[{"path":"docs/CLEAN_ROOM.md","sha256":"5408fc587fba32274195a8e104d7dbabe3a6a2f35f9e3abf1ed8fb73b367a8b3","locator":"Clean-Room-Produktionsregeln","runId":null}],"createdAtUtc":"2026-08-13T13:27:42.000Z","createdBy":"codex-clean-room-update","reviewedAtUtc":"2026-08-13T13:27:42.000Z","reviewedBy":"user-stated-ip-constraint","supersedes":[],"expiresAtUtc":null,"tags":["clean-room","originality","provenance","copyright"]}
{"schemaVersion":1,"id":"MEM-0008","kind":"decision","statement":"Alle kreativen Shipping-Assets entstehen aus freigegebenen internen Spezifikationen durch KI- oder agentisch gesteuerte prozedurale Synthese. Rohoutput beginnt in Quarant\u00E4ne; der Erzeuger darf sein eigenes Originalit\u00E4ts- oder Lizenzreview nicht abschlie\u00DFend freigeben.","status":"proposed","confidence":1,"scope":"production/synthetic-assets","conflictKey":"production.synthetic-asset-origin","sources":[{"path":"docs/entscheidungen/004-autonome-synthetische-assetproduktion.md","sha256":"11a21e16dd992cb8e8018adf9e2772c6114115bb65a08637755b19a8fe9a45bb","locator":"Entscheidung und Folgen","runId":null}],"createdAtUtc":"2026-08-13T14:30:00.000Z","createdBy":"codex-root-decision-capture","reviewedAtUtc":null,"reviewedBy":null,"supersedes":[],"expiresAtUtc":null,"tags":["assets","synthetic","provenance","clean-room"],"previousRecordHash":"b4a86b5103cdae5b3c5737ca0021e80b37da6a595203352088d8e0ef219393bc","recordHash":"38c3d6a3f097217f34371922c46a57143b19ac58074b7de4dfc1128f8a8f5981"}
