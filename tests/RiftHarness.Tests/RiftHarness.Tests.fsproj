<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/RiftHarness/RiftHarness.fsproj" />
    <ProjectReference Include="../../src/Riftward.Platform/Riftward.Platform.csproj" />
    <ProjectReference Include="../../src/Riftward.Save/Riftward.Save.csproj" />
    <ProjectReference Include="../../src/Riftward.App/Riftward.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssetCanonicalTests.fs" />
    <Compile Include="AssetRegression.fs" />
    <Compile Include="BlenderCalibrationSpecTests.fs" Condition="Exists('BlenderCalibrationSpecTests.fs')" />
    <Compile Include="Asset3dInspectorTests.fs" Condition="Exists('Asset3dInspectorTests.fs')" />
    <Compile Include="BlenderCalibrationCliTests.fs" />
    <Compile Include="BlenderCalibrationWrapperTests.fs" />
    <Compile Include="AssetJobJournalTests.fs" Condition="Exists('AssetJobJournalTests.fs')" />
    <Compile Include="DotnetAssetGeneratorTests.fs" Condition="Exists('DotnetAssetGeneratorTests.fs')" />
    <Compile Include="DotnetAssetCiEvidenceTests.fs" Condition="Exists('DotnetAssetCiEvidenceTests.fs')" />
    <Compile Include="DotnetAssetCiPolicyTests.fs" Condition="Exists('DotnetAssetCiPolicyTests.fs')" />
    <Compile Include="DotnetAssetPipelineTests.fs" Condition="Exists('DotnetAssetPipelineTests.fs')" />
    <Compile Include="DotnetAssetPipelineCliTests.fs" Condition="Exists('DotnetAssetPipelineCliTests.fs')" />
    <Compile Include="RunProvenanceTests.fs" />
    <Compile Include="ToolchainCheckTests.fs" Condition="Exists('ToolchainCheckTests.fs')" />
    <Compile Include="PlatformInteropTests.fs" Condition="Exists('PlatformInteropTests.fs')" />
    <Compile Include="BenchEmptyTests.fs" Condition="Exists('BenchEmptyTests.fs')" />
    <Compile Include="BenchSimTests.fs" Condition="Exists('BenchSimTests.fs')" />
    <Compile Include="BenchRepresentativeTests.fs" Condition="Exists('BenchRepresentativeTests.fs')" />
    <Compile Include="SoakTests.fs" Condition="Exists('SoakTests.fs')" />
    <Compile Include="SaveTests.fs" Condition="Exists('SaveTests.fs')" />
    <Compile Include="CommandLoopTests.fs" Condition="Exists('CommandLoopTests.fs')" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
